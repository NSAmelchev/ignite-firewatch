<?xml version="1.0" encoding="UTF-8"?>
<!-- The distribution: everything the controller needs besides JDK 17, Maven and git on the machine. -->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.1"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.1 https://maven.apache.org/xsd/assembly-2.1.1.xsd">
    <id>bin</id>
    <formats>
        <format>zip</format>
        <format>dir</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>ignite-firewatch-${project.version}</baseDirectory>

    <fileSets>
        <fileSet>
            <directory>${maven.multiModuleProjectDirectory}/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>
        <!-- only the committed defaults: a local settings.xml with credentials stays out of the zip -->
        <fileSet>
            <directory>${maven.multiModuleProjectDirectory}/config</directory>
            <outputDirectory>config</outputDirectory>
            <includes>
                <include>ignite-firewatch.properties</include>
            </includes>
        </fileSet>
    </fileSets>

    <files>
        <file>
            <source>${maven.multiModuleProjectDirectory}/LICENSE</source>
        </file>
        <file>
            <source>${maven.multiModuleProjectDirectory}/README.md</source>
        </file>
        <!-- the shaded, runnable jars (the modules' main artifacts are the plain ones) -->
        <file>
            <source>${maven.multiModuleProjectDirectory}/modules/controller/target/controller.jar</source>
            <outputDirectory>libs</outputDirectory>
        </file>
        <file>
            <source>${maven.multiModuleProjectDirectory}/modules/harness/target/harness.jar</source>
            <outputDirectory>libs</outputDirectory>
        </file>
    </files>
</assembly>
